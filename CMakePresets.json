{
  "version": 8,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Clang17",
      "displayName": "Clang 17.0.6 x86_64-pc-linux-gnu",
      "description": "Using compilers: C = /usr/bin/clang-17, CXX = /usr/bin/clang++-17",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "CMAKE_C_COMPILER": "/usr/bin/clang-17",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-17",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Clang23",
      "displayName": "Clang 23.0.0 x86_64-pc-linux-gnu",
      "description": "Using compilers: C = /usr/bin/clang-20, CXX = /usr/bin/clang++-20",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "CMAKE_C_COMPILER": "/usr/bin/clang-20",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-20",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}