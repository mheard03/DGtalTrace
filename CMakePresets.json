{
  "version": 8,
  "configurePresets": [
    {
      "name": "Clang20",
      "displayName": "Clang 20.1.2 x86_64-pc-linux-gnu",
      "description": "Using compilers: C = /usr/bin/clang-20, CXX = /usr/bin/clang++-20",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "CMAKE_C_COMPILER": "/usr/bin/clang-20",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-20",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Clang20",
      "configurePreset": "Clang20"
    }
  ]
}
